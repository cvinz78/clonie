detect_system() {
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        DISTRO="${ID:-unknown}"
    fi

    case "$DISTRO" in
        arch)
            PACKAGE_MANAGER="pacman"
            ;;
        ubuntu|debian|linuxmint|pop)
            PACKAGE_MANAGER="apt"
            ;;
        alpine)
            PACKAGE_MANAGER="apk"
            ;;
        *)
            PACKAGE_MANAGER=""
            ;;
    esac
}

package_for_command() {
    local command_name="$1"

    case "${PACKAGE_MANAGER}:${command_name}" in
        pacman:lsblk|pacman:blockdev|pacman:sfdisk|pacman:mountpoint) echo "util-linux" ;;
        pacman:dd|pacman:sha256sum|pacman:sync) echo "coreutils" ;;
        pacman:partprobe|pacman:parted) echo "parted" ;;
        pacman:zstd) echo "zstd" ;;
        pacman:xz) echo "xz" ;;
        pacman:gzip) echo "gzip" ;;
        pacman:openssl) echo "openssl" ;;
        pacman:ntfsresize|pacman:ntfsfix|pacman:ntfsinfo) echo "ntfsprogs" ;;

        apt:lsblk|apt:blockdev|apt:mountpoint) echo "util-linux" ;;
        apt:dd|apt:sha256sum|apt:sync) echo "coreutils" ;;
        apt:sfdisk) echo "fdisk" ;;
        apt:partprobe|apt:parted) echo "parted" ;;
        apt:zstd) echo "zstd" ;;
        apt:xz) echo "xz-utils" ;;
        apt:gzip) echo "gzip" ;;
        apt:openssl) echo "openssl" ;;
        apt:ntfsresize|apt:ntfsfix|apt:ntfsinfo) echo "ntfs-3g" ;;

        apk:lsblk|apk:blockdev|apk:mountpoint) echo "util-linux" ;;
        apk:dd|apk:sha256sum|apk:sync) echo "coreutils" ;;
        apk:sfdisk) echo "util-linux-misc" ;;
        apk:partprobe|apk:parted) echo "parted" ;;
        apk:zstd) echo "zstd" ;;
        apk:xz) echo "xz" ;;
        apk:gzip) echo "gzip" ;;
        apk:openssl) echo "openssl" ;;
        apk:ntfsresize|apk:ntfsfix|apk:ntfsinfo) echo "ntfs-3g-progs" ;;

        *)
            echo ""
            ;;
    esac
}

collect_missing() {
    local mode="$1"
    shift
    local missing=()
    local cmd

    for cmd in "$@"; do
        if ! command_exists "$cmd"; then
            missing+=("$cmd")
        fi
    done

    if [[ "${#missing[@]}" -gt 0 ]]; then
        if [[ "$mode" == "required" ]]; then
            install_packages "${missing[@]}" ||
                die "Ohne die fehlenden Werkzeuge (${missing[*]}) kann clonie nicht arbeiten."
        else
            install_packages "${missing[@]}" ||
                print_warn "Optionale Werkzeuge übersprungen: ${missing[*]}"
        fi
    fi
}

install_packages() {
    local commands_missing=("$@")
    local packages=()
    local cmd pkg

    for cmd in "${commands_missing[@]}"; do
        pkg="$(package_for_command "$cmd")"
        [[ -n "$pkg" ]] || continue
        if [[ ! " ${packages[*]-} " == *" $pkg "* ]]; then
            packages+=("$pkg")
        fi
    done

    if [[ "${#packages[@]}" -eq 0 ]]; then
        die "Fehlende Werkzeuge: ${commands_missing[*]} (Paketquelle unbekannt, Distribution: $DISTRO)"
    fi

    echo
    print_warn "Fehlende Werkzeuge: ${commands_missing[*]}"
    print_kv "Distribution:        " "$DISTRO"
    print_kv "Zu installieren:     " "${packages[*]}"
    echo

    if ! confirm "Pakete jetzt installieren?" "J"; then
        print_warn "Installation abgelehnt."
        return 1
    fi

    case "$PACKAGE_MANAGER" in
        pacman)
            pacman -Sy --needed --noconfirm "${packages[@]}" ||
                { print_warn "pacman-Installation fehlgeschlagen."; return 1; }
            ;;
        apt)
            apt-get update ||
                { print_warn "apt-get update fehlgeschlagen."; return 1; }
            DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}" ||
                { print_warn "apt-Installation fehlgeschlagen."; return 1; }
            ;;
        apk)
            apk add "${packages[@]}" ||
                { print_warn "apk-Installation fehlgeschlagen."; return 1; }
            ;;
        *)
            print_warn "Kein unterstützter Paketmanager (Distribution: $DISTRO). Bitte manuell installieren: ${commands_missing[*]}"
            return 1
            ;;
    esac

    return 0
}

check_tools() {
    collect_missing required lsblk blkid blockdev dd sha256sum sfdisk partprobe parted mountpoint sync awk grep sed
    collect_missing optional zstd ntfsresize ntfsfix ntfsinfo
    if ! command_exists zstd && ! command_exists xz && ! command_exists gzip; then
        die "Weder zstd, xz noch gzip gefunden – keine Kompression möglich."
    fi
}


dd_supports_fullblock() {
    dd if=/dev/zero of=/dev/null bs=512 count=0 iflag=fullblock 2>/dev/null
}

dd_supports_progress() {
    dd if=/dev/zero of=/dev/null bs=512 count=1 status=progress 2>/dev/null
}

set_dd_flags() {
    if dd_supports_fullblock; then
        DD_FULLBLOCK=(iflag=fullblock)
    else
        DD_FULLBLOCK=()
    fi

    if dd_supports_progress; then
        DD_STATUS=(status=progress)
    else
        DD_STATUS=()
    fi
}


confirm() {
    local prompt="$1"
    local default="${2:-N}"
    local answer=""
    local display=""

    case "$default" in
        J|j)
            default="J"
            display="[J/n]"
            ;;
        N|n)
            default="N"
            display="[j/N]"
            ;;
        *)
            die "Interner Fehler: ungültiger Standardwert für confirm."
            ;;
    esac

    while true; do
        print_prompt "$prompt $display "
        if ! read -r answer; then
            answer="$default"
        fi

        if [[ -z "$answer" ]]; then
            answer="$default"
        fi

        case "$answer" in
            j|J|y|Y) return 0 ;;
            n|N) return 1 ;;
            *) print_text "Bitte nur j oder n drücken." ;;
        esac
    done
}

menu_choose() {
    local title="$1"
    shift
    local options=("$@")

    if [[ "${#options[@]}" -eq 0 ]]; then
        die "Keine Auswahlmöglichkeiten für '$title' gefunden."
    fi

    local default="${MENU_DEFAULT_CHOICE:-}"
    MENU_DEFAULT_CHOICE=""

    echo
    print_heading "$title"
    local i
    for i in "${!options[@]}"; do
        printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${COLOR_TEXT}${options[$i]}${COLOR_RESET}"
    done
    printf '%b\n' "${COLOR_OTHER}0)${COLOR_RESET} ${COLOR_TEXT}Zurück${COLOR_RESET}   ${COLOR_OTHER}00)${COLOR_RESET} ${COLOR_TEXT}Beenden${COLOR_RESET}   ${COLOR_OTHER}000)${COLOR_RESET} ${COLOR_TEXT}Abbrechen${COLOR_RESET}"
    echo

    local choice
    while true; do
        if [[ -n "$default" ]]; then
            print_prompt "Auswahl [Enter = $default]: "
        else
            print_prompt "Auswahl: "
        fi
        if ! read -r choice; then
            if [[ -n "$default" ]]; then
                choice="$default"
                break
            fi
            exit 1
        fi
        if [[ "$choice" == "0" ]]; then
            if [[ "$MENU_TOP" == "1" ]]; then
                MENU_ACTION="back"
                return 0
            fi
            exit 0
        fi
        if [[ "$choice" == "00" ]]; then
            if [[ "$MENU_TOP" == "1" ]]; then
                print_other "Auf Wiedersehen."
                exit 0
            fi
            menu_quit
        fi
        if [[ "$choice" == "000" ]]; then
            user_abort
        fi
        if [[ "$choice" =~ ^[0-9]+$ ]] &&
            ((choice >= 0 && choice <= ${#options[@]})); then
            break
        fi
        if [[ -z "$choice" && -n "$default" ]]; then
            choice="$default"
            break
        fi
        print_text "Ungültige Auswahl."
    done

    SELECTED_ITEM_INDEX=$((choice - 1))
}


