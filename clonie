        fi
        ASK_FILE_RESULT="$path"
        return 0
    done
}

ask_image_base() {
    local prompt="Image-Basisname (ohne Endung): "
    local base

    if [[ -n "${1:-}" ]]; then
        prompt="$1"
    fi
    while true; do
        print_prompt "$prompt"
        if ! read -r base; then
            die "Vom Benutzer abgebrochen."
        fi
        case "$base" in
            0) exit 0 ;;
            00) menu_quit ;;
            000) user_abort ;;
        esac
        if [[ -z "$base" ]]; then
            print_warn "Kein Name angegeben – bitte erneut eingeben (0 = zurück)."
            continue
        fi
        if [[ "$base" == */* ]]; then
            print_warn "Der Name darf keinen Pfad enthalten – bitte erneut eingeben."
