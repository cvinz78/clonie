    else
        default_file="$(pwd)/$(basename "$disk")-parttable-$(date +%Y%m%d-%H%M%S).txt"
    fi
    ask_output_file "$default_file"
    dump_file="$ASK_FILE_RESULT"

    if ! sfdisk -d "$disk" > "$dump_file"; then
        rm -f -- "$dump_file"
        die "sfdisk-Dump fehlgeschlagen."
    fi

    echo
    print_other "Partitionstabelle gesichert:"
    print_kv_path "   " "$dump_file"
    if host_dir_active; then
        print_text "Der Dump liegt im Image-Host-Ordner und wird beim"
        print_text "Zurückspielen dort zur Auswahl gelistet."
    else
        print_text "Diese Datei vor dem Zurückspielen SICHERN (z. B. auf USB-Stick)!"
    fi
}

collect_table_dumps() {
    local dir="$1" f base rel
    TABLE_FILES=()
    TABLE_NAMES=()
    for f in "$dir"/*.txt "$dir"/*/*.txt; do
        [[ -f "$f" ]] || continue
        case "$f" in
            *.manifest.txt) continue ;;
        esac
        base="$(basename "$f")"
        rel="${f#"$dir"/}"
        rel="${rel%/*}"
        if [[ "$rel" == "$base" ]]; then
            TABLE_NAMES+=("$base")
        else
            TABLE_NAMES+=("$base ($rel)")
        fi
        TABLE_FILES+=("$f")
    done
}

table_restore_flow() {
    local disk
    local dump_file

    echo
    print_heading "=============================================="
    print_heading "  PARTITIONSTABELLE ZURÜCKSPIELEN"
    print_heading "=============================================="
    echo

    dump_file=""
    while [[ -z "$dump_file" ]]; do
        if host_dir_active; then
            collect_table_dumps "$IMAGE_HOST_DIR"
            if [[ "${#TABLE_FILES[@]}" -gt 0 ]]; then
                menu_choose "Dump-Datei im Image-Host-Ordner wählen:" "${TABLE_NAMES[@]}"
                dump_file="${TABLE_FILES[$SELECTED_ITEM_INDEX]}"
            else
                print_warn "Keine Dump-Dateien (*.txt) im Image-Host-Ordner: $IMAGE_HOST_DIR"
                ask_image_file "Pfad zur Dump-Datei (sfdisk-Format): "
                dump_file="$ASK_FILE_RESULT"
            fi
        else
            ask_image_file "Pfad zur Dump-Datei (sfdisk-Format): "
            dump_file="$ASK_FILE_RESULT"
        fi
        if ! grep -q '^label:' "$dump_file"; then
            print_warn "$dump_file ist kein sfdisk-Dump (keine 'label:'-Zeile) – bitte andere Datei wählen."
            dump_file=""
        fi
    done

    choose_disk "Ziel"
    disk="$SELECTED_DISK"

    echo
    print_warn "ACHTUNG: Die aktuelle Partitionstabelle auf $disk wird überschrieben."
    print_warn "Daten in den Partitionen bleiben erhalten, aber die Zuordnung ändert"
    print_warn "sich – bei falscher Dump-Datei droht DATENVERLUST!"
    echo

    confirm "Partitionstabelle wirklich zurückspielen?" "N" ||
        die "Vom Benutzer abgebrochen."

    sfdisk --force "$disk" < "$dump_file" ||
        die "sfdisk-Restore fehlgeschlagen."

    partprobe "$disk" 2>/dev/null || true

    echo
    print_other "Partitionstabelle zurückgespielt auf $disk."
}


part_number_of() {
    local part="$1"
    local disk="$2"
    local n

    n="${part#"$disk"}"
    n="${n#p}"

    [[ "$n" =~ ^[0-9]+$ ]] ||
        die "Partitionsnummer konnte nicht ermittelt werden ($part)."

    printf '%s' "$n"
}

resize_fs_of_part() {
    local part="$1"
    local fs
    local fs_rc

    fs="$(fs_of_part "$part")"

    case "$fs" in
        ntfs)
            print_text "Vergrößere NTFS-Dateisystem mit ntfsresize ..."
            if ! ntfsresize -f "$part"; then
                print_warn "ntfsresize fehlgeschlagen – bitte manuell prüfen."
                return 1
            fi
            ;;
        ext2|ext3|ext4)
            print_text "Prüfe ext-Dateisystem mit e2fsck ..."
            fs_rc=0
            e2fsck -fp "$part" || fs_rc=$?
            if (( fs_rc > 2 )); then
                print_warn "e2fsck fehlgeschlagen – bitte manuell prüfen."
                return 1
            fi
            print_text "Vergrößere ext-Dateisystem mit resize2fs ..."
            if ! resize2fs "$part"; then
                print_warn "resize2fs fehlgeschlagen – bitte manuell prüfen."
                return 1
            fi
            ;;
        vfat|fat16|fat32|exfat)
            print_text "FAT/exFAT wird nicht automatisch vergrößert (manuell: fatresize)."
            ;;
        ""|swap)
            print_text "Kein vergrößerbares Dateisystem erkannt (${fs:-unbekannt})."
            ;;
        *)
            print_text "Dateisystem '$fs' – keine automatische Vergrößerung möglich."
            ;;
    esac

    return 0
}

resize_part_to_end() {
    local disk="$1"
    local part="$2"
    local n
    local fs
    local -a parted_opts=(-s)

    n="$(part_number_of "$part" "$disk")"
    fs="$(fs_of_part "$part")"

    ensure_not_mounted "$part"

    echo
    print_text "Vergrößere $part bis zum Plattenende von $disk ..."

    if parted -h 2>&1 | grep -q -- '-f, --fix'; then
        parted_opts+=(-f)
    fi

    if ! parted "${parted_opts[@]}" "$disk" resizepart "$n" 100%; then
        print_warn "parted resizepart fehlgeschlagen (ist $part die letzte Partition?)."
        return 1
    fi

    partprobe "$disk" 2>/dev/null || true

    print_other "Partition vergrößert: $part ist jetzt $(fmt_size "$(dev_size_bytes "$part")")."

    if [[ "$fs" == "ntfs" ]]; then
        print_text "Hinweis: Windows beim nächsten Start ggf. chkntfs/chkdsk ausführen lassen."
    fi

    resize_fs_of_part "$part" || true
    return 0
}

offer_resize() {
    local kind="$1"
    local tgt="$2"
    local tgt_disk="$3"

    echo
    if [[ "$kind" == "disk" ]]; then
        if ! confirm "Partition auf $tgt anpassen (z. B. Windows-Partition auf größere Platte vergrößern)?" "N"; then
            return 0
        fi
        choose_partition "Anzupassende Partition (auf $tgt)" "$tgt"
        resize_part_to_end "$tgt_disk" "$SELECTED_PART" || true
    else
        if ! confirm "Dateisystem auf $tgt an die neue Größe anpassen (NTFS/ext)?" "N"; then
            return 0
        fi
        ensure_not_mounted "$tgt"
        resize_fs_of_part "$tgt" || true
    fi
}


parse_selection() {
    local input="$1"
    local max="$2"
    local -a tokens=()
    local -a result=()
    local token first last n

    input="${input//[[:space:]]/}"
    [[ -n "$input" ]] || return 1
    IFS=',' read -r -a tokens <<<"$input"

    for token in "${tokens[@]}"; do
        [[ -n "$token" ]] || return 1
        if [[ "$token" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            first="${BASH_REMATCH[1]}"
            last="${BASH_REMATCH[2]}"
            ((first >= 1 && first <= last && last <= max)) || return 1
            for ((n = first; n <= last; n++)); do
                result+=("$n")
            done
        elif [[ "$token" =~ ^[0-9]+$ ]]; then
            ((token >= 1 && token <= max)) || return 1
            result+=("$token")
        else
            return 1
        fi
    done

    mapfile -t result < <(printf '%s\n' "${result[@]}" | sort -nu)
    SELECTED_NUMBERS=("${result[@]}")
    return 0
}

manifest_value() {
    local manifest="$1"
    local key="$2"
    local part="${3:-}"

    awk -v want_part="$part" -v key="$key" '
        BEGIN { inblock = (want_part == "") }
        /^\[/ {
            cur = $0
            sub(/^\[/, "", cur); sub(/\]$/, "", cur)
            inblock = (want_part == "" || cur == want_part)
            next
        }
        inblock && index($0, key ":") == 1 {
            val = substr($0, length(key) + 2)
            sub(/^[ \t]+/, "", val)
            print val
            exit
        }
    ' "$manifest"
}

manifest_part_names() {
    awk -F': ' '/^Partitionen:/ { print $2; exit }' "$1"
}

tar_is_gnu() {
    tar --version 2>/dev/null | grep -qi gnu
}

multi_backup_run() {
    local src_disk="$1"
    shift
    local sel_paths=("$@")
    local -a part_sizes=()
    local -a part_fses=()
    local -a part_bases=()
    local -a kept_files=()
    local -a meta_files=(MANIFEST.txt)
    local part part_size part_fs part_base part_file
    local image_dir image_base image_path checksum
    local dir_disk
    local stamp n
    local tmpdir
    local pipeline_status
    local count n
    local enc_suffix=""

    echo
    print_heading "=============================================="
    print_heading "  MEHRERE PARTITIONEN SICHERN (ein Image)"
    print_heading "=============================================="
    echo

    warn_windows_source "$src_disk"

    echo
    print_text "Gesichert werden:"
    for part in "${sel_paths[@]}"; do
        part_size="$(dev_size_bytes "$part")"
        part_fs="$(fs_of_part "$part")"
        part_base="${part#/dev/}"
        ensure_not_mounted "$part"
        part_sizes+=("$part_size")
        part_fses+=("$part_fs")
        part_bases+=("$part_base")
        print_kv_path "   " "$part  $(fmt_size "$part_size")"
    done

    choose_compression
    ask_encryption
    if ((ENCRYPT_IMAGE)); then
        enc_suffix=".enc"
        export CLONIE_ENC_PASS="$ENC_PASSPHRASE"
    fi

    if host_dir_active; then
        ask_image_base "Name für den Sicherungsordner: "
        host_backup_dir "$ASK_BASE_RESULT"
        image_dir="$BACKUP_DIR"
        echo
        print_text "Gespeichert wird im Image-Host-Ordner, Unterordner:"
        print_kv_path "   " "$image_dir"
        [[ -w "$image_dir" ]] ||
            die "Zielverzeichnis ist nicht beschreibbar: $image_dir"
        dir_disk="$(target_parent_disk "$image_dir")"
        if [[ -n "$dir_disk" && "$dir_disk" == "$src_disk" ]]; then
            die "Zielverzeichnis liegt auf der Quellplatte ($src_disk) – das Schreiben würde die Quelle zerstören. Bitte ein Verzeichnis auf einer ANDEREN Platte wählen."
        fi
        stamp="$(date +%Y%m%d-%H%M%S)"
        image_base="$(basename "$src_disk")_${stamp}"
        n=2
        while [[ -e "${image_dir%/}/${image_base}.tar" ]]; do
            image_base="$(basename "$src_disk")_${stamp}_${n}"
            n=$((n + 1))
        done
        image_path="${image_dir%/}/${image_base}.tar"
    else
        echo
        print_text "Wohin soll das Image gespeichert werden?"
        print_warn "WICHTIG: NICHT auf die Quellplatte ($src_disk) selbst!"
        echo
        ask_target_dir "$src_disk"
        image_dir="$ASK_DIR_RESULT"
        while true; do
            ask_image_base
            image_base="$ASK_BASE_RESULT"
            image_path="${image_dir%/}/${image_base}.tar"
            if [[ ! -e "$image_path" ]]; then
                break
            fi
            print_warn "Image existiert bereits: $image_path – bitte anderen Namen wählen."
        done
    fi
    checksum="${image_path}.sha256"

    echo
    print_kv_path "Quellplatte:  " "$src_disk"
    print_kv "Partitionen:   ${SELECTED_NUMBERS[*]}"
    print_kv "Kompression:   $COMPRESSION"
    if ((ENCRYPT_IMAGE)); then
        print_kv "Verschlüsselung: AES-256-CTR (openssl, PBKDF2, $ENC_ITER Iterationen)"
    fi
    print_kv_path "Image:        " "$image_path"
    echo

    confirm "Sicherung wirklich starten?" "N" ||
        { print_text "Abgebrochen."; return 0; }

    tmpdir="$(mktemp -d "${image_dir%/}/.clonie-mbi-XXXXXXXX")" ||
        die "Temporäres Verzeichnis konnte nicht erstellt werden."
    TMP_CLEANUP="$tmpdir"

    {
        printf 'Erstellt: '
        date -Iseconds 2>/dev/null || date
        printf 'Quellplatte: %s\n' "$src_disk"
        printf 'Kompression: %s\n' "$COMPRESSION"
        if ((ENCRYPT_IMAGE)); then
            printf 'Verschlüsselung: AES-256-CTR (openssl, PBKDF2, %s Iterationen)\n' "$ENC_ITER"
        fi
        printf 'Blockgröße: %s\n' "$BLOCK_SIZE"
        printf 'Partitionen: %s\n' "${part_bases[*]}"
    } > "$tmpdir/MANIFEST.txt"

    if ((ENCRYPT_IMAGE)); then
        write_passcheck "$tmpdir/clonie-passcheck" ||
            die "Passcheck-Member konnte nicht erstellt werden."
        meta_files+=(clonie-passcheck)
    fi

    if sfdisk -d "$src_disk" > "$tmpdir/sfdisk-dump.txt" 2>/dev/null; then
        meta_files+=(sfdisk-dump.txt)
    else
        rm -f "$tmpdir/sfdisk-dump.txt"
        print_warn "sfdisk-Dump der Quellplatte fehlgeschlagen (wird übersprungen)."
    fi

    count=0
    for part in "${sel_paths[@]}"; do
        {
            printf '\n[%s]\n' "${part_bases[$count]}"
            printf 'Quelle: %s\n' "$part"
            printf 'Quellgröße_bytes: %s\n' "${part_sizes[$count]}"
            printf 'Dateisystem: %s\n' "${part_fses[$count]}"
        } >> "$tmpdir/MANIFEST.txt"
        count=$((count + 1))
    done

    if tar_is_gnu; then
        tar -cf "$image_path" -C "$tmpdir" "${meta_files[@]}" ||
            { rm -f -- "$image_path"; die "tar-Image konnte nicht erstellt werden."; }
    fi

    count=0
    for part in "${sel_paths[@]}"; do
        part_base="${part_bases[$count]}"
        if [[ "$IMAGE_SUFFIX" == ".img" ]]; then
            part_file="${part_base}.img"
        else
            part_file="${part_base}.img${IMAGE_SUFFIX}"
        fi
        part_file="${part_file}${enc_suffix}"

        print_other "Sichere $part ($(fmt_size "${part_sizes[$count]}")) ..."

        if ((ENCRYPT_IMAGE)); then
            set +e
            dd \
                if="$part" \
                bs="$BLOCK_SIZE" \
                ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
                ${DD_STATUS[@]+"${DD_STATUS[@]}"} |
                "${COMPRESSOR[@]}" |
                openssl enc "${ENC_CIPHER_ARGS[@]}" -pass env:CLONIE_ENC_PASS > "$tmpdir/$part_file"
            pipeline_status=("${PIPESTATUS[@]}")
            set -e

            if ((pipeline_status[0] != 0 || pipeline_status[1] != 0 || pipeline_status[2] != 0)); then
                rm -f -- "$image_path"
                die "Sicherung von $part fehlgeschlagen (dd=${pipeline_status[0]}, Kompressor=${pipeline_status[1]}, Verschlüsselung=${pipeline_status[2]})."
            fi
        else
            set +e
            dd \
                if="$part" \
                bs="$BLOCK_SIZE" \
                ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
                ${DD_STATUS[@]+"${DD_STATUS[@]}"} |
                "${COMPRESSOR[@]}" > "$tmpdir/$part_file"
            pipeline_status=("${PIPESTATUS[@]}")
            set -e

            if ((pipeline_status[0] != 0 || pipeline_status[1] != 0)); then
                rm -f -- "$image_path"
                die "Sicherung von $part fehlgeschlagen (dd=${pipeline_status[0]}, Kompressor=${pipeline_status[1]})."
            fi
        fi

        (
            cd "$tmpdir" &&
                sha256sum "$part_file" > "$part_file.sha256"
        ) || die "SHA-256 von $part konnte nicht berechnet werden."

        if tar_is_gnu; then
            tar -rf "$image_path" -C "$tmpdir" "$part_file" "$part_file.sha256" ||
                { rm -f -- "$image_path"; die "Anfügen von $part_file an das Image fehlgeschlagen."; }
            rm -f -- "$tmpdir/$part_file" "$tmpdir/$part_file.sha256"
        else
            kept_files+=("$part_file" "$part_file.sha256")
        fi
        count=$((count + 1))
    done

    if ! tar_is_gnu; then
        tar -cf "$image_path" -C "$tmpdir" "${meta_files[@]}" \
            ${kept_files[@]+"${kept_files[@]}"} ||
            { rm -f -- "$image_path"; die "tar-Image konnte nicht erstellt werden."; }
    fi

    rm -rf -- "$tmpdir"
    TMP_CLEANUP=""

    sync

    print_text "SHA-256-Prüfsumme des Images wird berechnet ..."
    sha256sum "$image_path" > "$checksum"

    echo
    print_other "Partitions-Image erfolgreich erstellt:"
    print_kv_path "   Image:        " "$image_path"
    print_kv_path "   Prüfsumme:    " "$checksum"
    if ((ENCRYPT_IMAGE)); then
        print_text "   Verschlüsselung: AES-256-CTR (Passcheck-Member im Image)"
    fi
    print_text "   Enthalten: ${part_bases[*]}"
    print_text "   Einzeln zurückspielbar über 'Partitions-Image (Multi) zurückspielen'."
}

multi_restore_run() {
    local image="$1"
    local checksum tmpdir image_dir
    local member member_base
    local -a names=()
    local -a sizes=()
    local -a fses=()
    local -a sources=()
    local -a name_tokens=()
    local -a sel_names=()
    local -a sel_sizes=()
    local -a sel_fses=()
    local -a sel_sources=()
    local -a sel_members=()
    local -a targets=()
    local -a tgt_sizes=()
    local -a tgt_disks=()
    local names_line part_name n i sel_input sel_norm
    local src_size tgt tgt_size
    local pipeline_status

    echo
    print_heading "=============================================="
    print_heading "  PARTITIONS-IMAGE ZURÜCKSPIELEN (Multi)"
    print_heading "=============================================="
    echo

    [[ -f "$image" ]] || die "Image nicht gefunden: $image"

    checksum="${image}.sha256"
    if [[ -f "$checksum" ]]; then
        print_text "Prüfsumme wird geprüft ..."
        (
            cd "$(dirname "$image")" &&
                sha256sum -c "$(basename "$image").sha256"
        ) || die "Prüfsumme stimmt nicht – Image beschädigt oder falsches Ziel."
    else
        print_warn "Keine Prüfsumme gefunden: $checksum"
        confirm "Ohne Prüfsummenprüfung fortfahren?" "N" ||
            die "Abgebrochen."
    fi

    image_dir="$(dirname "$image")"
    tmpdir="$(mktemp -d "${image_dir%/}/.clonie-mri-XXXXXXXX" 2>/dev/null)" ||
        tmpdir=""
    if [[ -z "$tmpdir" ]]; then
        print_warn "Image-Ordner nicht beschreibbar – Extraktion nach ${TMPDIR:-/tmp} (Platz beachten)."
        tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/clonie-mri-XXXXXXXX")" ||
            die "Temporäres Verzeichnis konnte nicht erstellt werden."
    fi
    TMP_CLEANUP="$tmpdir"

    if ! tar -xf "$image" -C "$tmpdir" MANIFEST.txt; then
        die "Image enthält kein MANIFEST.txt – kein clonie-Mehrpartitions-Image?"
    fi

    if tar -tf "$image" | grep -qx 'clonie-passcheck'; then
        tar -xf "$image" -C "$tmpdir" clonie-passcheck ||
            die "Extraktion des Passcheck-Members fehlgeschlagen."
        print_text "Verschlüsseltes Partitions-Image erkannt (AES-256)."
        restore_ask_password "$tmpdir/clonie-passcheck"
    elif tar -tf "$image" | grep -q '\.enc$'; then
        print_text "Verschlüsseltes Partitions-Image erkannt (AES-256)."
        restore_ask_password ""
    fi

    names_line="$(manifest_part_names "$tmpdir/MANIFEST.txt")"
    if [[ -z "$names_line" ]]; then
        die "Manifest listet keine Partitionen auf: ${image}"
    fi
    IFS=' ' read -r -a name_tokens <<<"$names_line"

    for part_name in "${name_tokens[@]}"; do
        names+=("$part_name")
        sizes+=("$(manifest_value "$tmpdir/MANIFEST.txt" "Quellgröße_bytes" "$part_name")")
        fses+=("$(manifest_value "$tmpdir/MANIFEST.txt" "Dateisystem" "$part_name")")
        sources+=("$(manifest_value "$tmpdir/MANIFEST.txt" "Quelle" "$part_name")")
    done

    echo
    print_heading "Partitions-Image enthält:"
    for i in "${!names[@]}"; do
        printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${COLOR_TEXT}${names[$i]}${COLOR_RESET}  $(fmt_size "${sizes[$i]}")  [${fses[$i]:-unbekannt}]  (ursprünglich ${sources[$i]:-?})"
    done
    echo

    while true; do
        print_prompt "Wiederherzustellende Partitionen (z. B. 2 oder 1,3; 0 = zurück): "
        if ! read -r sel_input; then
            die "Vom Benutzer abgebrochen."
        fi
        sel_norm="${sel_input//[[:space:]]/}"
        if [[ "$sel_norm" == "0" ]]; then
            exit 0
        fi
        if [[ "$sel_norm" == "00" ]]; then
            menu_quit
        fi
        if [[ "$sel_norm" == "000" ]]; then
            user_abort
        fi
        if parse_selection "$sel_norm" "${#names[@]}"; then
            break
        fi
        print_text "Ungültige Auswahl: ${sel_norm:-leer}"
    done

    tar -tf "$image" > "$tmpdir/members.list" ||
        die "Imageliste konnte nicht gelesen werden: $image"
    for n in "${SELECTED_NUMBERS[@]}"; do
        part_name="${names[$((n - 1))]}"
        member="$(grep -E "^${part_name}\.img(\.|$)" "$tmpdir/members.list" | awk 'NR == 1 { print; exit }')" || member=""
        if [[ -z "$member" ]]; then
            die "Keine Imagedatei für $part_name im Image gefunden."
        fi
        sel_names+=("$part_name")
        sel_sizes+=("${sizes[$((n - 1))]}")
        sel_fses+=("${fses[$((n - 1))]}")
        sel_sources+=("${sources[$((n - 1))]}")
        sel_members+=("$member")
    done

    local -a rows=()
    local -a all_paths=()
    local row dev size fs src_list

    while IFS= read -r row; do
        rows+=("$row")
    done < <(list_partitions "")

    if [[ "${#rows[@]}" -eq 0 ]]; then
        die "Keine Partitionen gefunden (Zielwahl)."
    fi

    echo
    print_heading "Ziele wählen:"
    print_warn "Jede Zielpartition wird VOLLSTÄNDIG überschrieben!"
    for i in "${!rows[@]}"; do
        IFS='|' read -r dev size <<<"${rows[$i]}"
        fs="$(fs_of_part "$dev")"
        all_paths+=("$dev")
        if [[ -n "$fs" ]]; then
            printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [${fs}]"
        else
            printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [kein FS]"
        fi
    done
    echo
    src_list="${sel_names[*]}"
    print_text "Ziele für die Quellpartitionen (aufsteigend: ${src_list}) angeben."
    print_text "Eine Zahl oder mehrere (z. B. 1,3 oder 1-4); Anzahl: ${#sel_names[@]}."

    while true; do
        print_prompt "Ziele (0 = zurück, 00 = beenden, 000 = abbrechen): "
        if ! read -r sel_input; then
            die "Vom Benutzer abgebrochen."
        fi
        sel_norm="${sel_input//[[:space:]]/}"
        if [[ "$sel_norm" == "0" ]]; then
            exit 0
        fi
        if [[ "$sel_norm" == "00" ]]; then
            menu_quit
        fi
        if [[ "$sel_norm" == "000" ]]; then
            user_abort
        fi
        if ! parse_selection "$sel_norm" "${#all_paths[@]}"; then
            print_text "Ungültige Auswahl: ${sel_norm:-leer}"
            continue
        fi
        if (( ${#SELECTED_NUMBERS[@]} != ${#sel_names[@]} )); then
            print_text "Genau ${#sel_names[@]} Ziele angeben (nicht ${#SELECTED_NUMBERS[@]})."
            continue
        fi
        break
    done

    for i in "${!sel_names[@]}"; do
        part_name="${sel_names[$i]}"
        src_size="${sel_sizes[$i]}"
        member_base="$(basename "${sel_members[$i]}")"
        tgt="${all_paths[$((SELECTED_NUMBERS[i] - 1))]}"
        tgt_size="$(dev_size_bytes "$tgt")"

        echo
        print_kv_path "Image-Datei:  " "$member_base"
        print_kv "Quelle:        ${sel_sources[$i]:-$part_name} ($(fmt_size "$src_size"), ${sel_fses[$i]:-unbekannt})"
        print_kv_path "Ziel:          " "$tgt  ($(fmt_size "$tgt_size"))"

        if ((tgt_size < src_size)); then
            die "Zielpartition zu klein: $(fmt_size "$tgt_size") < Quellgröße $(fmt_size "$src_size")."
        fi

        ensure_not_mounted "$tgt"

        targets+=("$tgt")
        tgt_sizes+=("$tgt_size")
        tgt_disks+=("$(source_disk_of_part "$tgt")")
    done

    echo
    print_heading "Zurückgespielt werden:"
    for i in "${!sel_names[@]}"; do
        print_kv_path "   " "${sel_names[$i]}  ->  ${targets[$i]}  ($(fmt_size "${tgt_sizes[$i]}"))"
    done
    echo
    print_warn "ACHTUNG: ALLE Daten auf den genannten Zielen werden UNWIDERRUFLICH überschrieben!"
    echo

    if (( ${#sel_names[@]} == 1 )); then
        confirm "Wirklich 1 Partition zurückspielen?" "N" || die "Vom Benutzer abgebrochen."
    else
        confirm "Wirklich ${#sel_names[@]} Partitionen zurückspielen?" "N" || die "Vom Benutzer abgebrochen."
    fi

    for i in "${!sel_names[@]}"; do
        part_name="${sel_names[$i]}"
        member="${sel_members[$i]}"
        member_base="$(basename "$member")"
        tgt="${targets[$i]}"
        tgt_size="${tgt_sizes[$i]}"
        src_size="${sel_sizes[$i]}"

        print_other "Extrahiere $member_base ..."
        if grep -Fqx "${member}.sha256" "$tmpdir/members.list"; then
            tar -xf "$image" -C "$tmpdir" "$member" "${member}.sha256" ||
                die "Extraktion von $member_base fehlgeschlagen."
        else
            tar -xf "$image" -C "$tmpdir" "$member" ||
                die "Extraktion von $member_base fehlgeschlagen."
        fi

        if [[ -f "$tmpdir/${member_base}.sha256" ]]; then
            print_text "Prüfsumme von $member_base wird geprüft ..."
            (
                cd "$tmpdir" &&
                    sha256sum -c "${member_base}.sha256"
            ) || die "Prüfsumme von $member_base stimmt nicht – Image beschädigt."
        else
            print_warn "Keine Prüfsumme für $member_base im Image."
        fi

        decompressor_from_suffix "$member_base"

        print_other "Wiederherstellung läuft ($part_name -> $tgt) ..."

        if (( ${#DECRYPTOR[@]} > 0 )); then
            set +e
            "${DECRYPTOR[@]}" -in "$tmpdir/$member_base" |
                "${DECOMPRESSOR[@]}" |
                dd of="$tgt" bs="$BLOCK_SIZE" conv=fsync \
                    ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
                    ${DD_STATUS[@]+"${DD_STATUS[@]}"}
            pipeline_status=("${PIPESTATUS[@]}")
            set -e

            if ((pipeline_status[0] != 0 || pipeline_status[1] != 0 || pipeline_status[2] != 0)); then
                die "Wiederherstellung fehlgeschlagen (Entschlüsselung=${pipeline_status[0]}, Dekompressor=${pipeline_status[1]}, dd=${pipeline_status[2]})."
            fi
        else
            set +e
            "${DECOMPRESSOR[@]}" "$tmpdir/$member_base" |
                dd of="$tgt" bs="$BLOCK_SIZE" conv=fsync \
                    ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
                    ${DD_STATUS[@]+"${DD_STATUS[@]}"}
            pipeline_status=("${PIPESTATUS[@]}")
            set -e

            if ((pipeline_status[0] != 0 || pipeline_status[1] != 0)); then
                die "Wiederherstellung fehlgeschlagen (Dekompressor=${pipeline_status[0]}, dd=${pipeline_status[1]})."
            fi
        fi
        sync

        echo
        print_other "$part_name erfolgreich zurückgespielt auf $tgt."

        if ((tgt_size > src_size)); then
            offer_resize "part" "$tgt" "${tgt_disks[$i]}"
        fi

        rm -f -- "$tmpdir/$member_base" "$tmpdir/${member_base}.sha256"
    done

    rm -rf -- "$tmpdir"
    TMP_CLEANUP=""

    echo
    print_other "Alle gewählten Partitionen wurden zurückgespielt."
}


main_menu() {
    local options=(
        "Festplatte 1:1 klonen"
        "Partition 1:1 klonen"
        "Image von Festplatte erstellen (komprimiert)"
        "Image von Partition(en) erstellen (komprimiert)"
        "Image zurückspielen (recover)"
        "Partitionstabelle sichern (sfdisk-Dump)"
        "Partitionstabelle zurückspielen"
        "Image-Host-Ordner wählen/wechseln"
        "Festplatten erneut einlesen"
    )

    local rc

    while true; do
        echo
        print_heading "=============================================="
        print_heading "  clonie $VERSION – Festplatte/Partition/Image"
        print_heading "=============================================="
        print_kv "System:        " "${DISTRO} (${PACKAGE_MANAGER:-kein Paketmanager})"
        if [[ -n "$IMAGE_HOST_DIR" ]]; then
            print_kv_path "Image-Ordner:  " "$IMAGE_HOST_DIR"
        else
            print_kv "Image-Ordner:  " "(nicht festgelegt)"
        fi
        echo

        MENU_TOP="1"
        menu_choose "Aktion wählen:" "${options[@]}"
        if [[ "$MENU_ACTION" == "back" ]]; then
            MENU_ACTION=""
            continue
        fi
        MENU_TOP=""

        rc=0
        case "$SELECTED_ITEM_INDEX" in
            0) ( clone_disk_flow ) || rc=$? ;;
            1) ( clone_partition_flow ) || rc=$? ;;
            2) ( create_image "disk" ) || rc=$? ;;
            3) ( create_image "part" ) || rc=$? ;;
            4) ( restore_image ) || rc=$? ;;
            5) ( table_backup_flow ) || rc=$? ;;
            6) ( table_restore_flow ) || rc=$? ;;
            7)
                rc=0
                ( choose_image_host "menu" ) || rc=$?
                if ((rc == 43)); then
                    host_dir_reload
                    rc=0
                fi
                ;;
            8) ( rescan_disks ) || rc=$? ;;
        esac

        if [[ "$rc" -eq 42 ]]; then
            exit 0
        fi
        if [[ "$rc" -ne 0 ]]; then
            exit "$rc"
        fi

        echo
        print_prompt "Eingabetaste fürs Hauptmenü ..."
        read -r || { print_other "Auf Wiedersehen."; exit 0; }
    done
}

main() {
    local want_help=0
    local want_version=0

    while (( $# > 0 )); do
        case "$1" in
            -h|--help)
                want_help=1
                ;;
            -v|-V|--version)
                want_version=1
                ;;
            -nc|--no-color)
                NO_COLOR=1
                ;;
            -de|-en)
                ;;
            *)
                init_colors
                print_warn "Unbekanntes Argument: $1"
                usage
                exit 2
                ;;
        esac
        shift
    done

    init_colors

    if ((want_help)); then
        usage
        exit 0
    fi
    if ((want_version)); then
        printf 'clonie %s\n' "$VERSION"
        exit 0
    fi

    detect_system
    require_root
    check_tools
    set_dd_flags

    HOST_DIR_STATE="$(mktemp "${TMPDIR:-/tmp}/clonie-host-XXXXXXXX" 2>/dev/null)" || HOST_DIR_STATE=""

    local rc=0
    ( choose_image_host "start" ) || rc=$?
    if ((rc == 42)); then
        exit 0
    fi
    if ((rc != 0)); then
        exit "$rc"
    fi
    host_dir_reload

    main_menu
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
