        fi
        ASK_BASE_RESULT="$base"
        return 0
    done
}

ask_output_file() {
    local default_file="$1"
    local file parent

    while true; do
        print_prompt "Zieldatei [$default_file]: "
        if ! read -r file; then
            die "Vom Benutzer abgebrochen."
        fi
        case "$file" in
            0) exit 0 ;;
            00) menu_quit ;;
            000) user_abort ;;
        esac
        [[ -n "$file" ]] || file="$default_file"
        if [[ -e "$file" ]]; then
            print_warn "Datei existiert bereits: $file – bitte anderen Namen wählen."
            continue
        fi
        parent="$(dirname -- "$file")"
        if [[ ! -d "$parent" || ! -w "$parent" ]]; then
            print_warn "Zielverzeichnis fehlt oder ist nicht beschreibbar: $parent – bitte erneut eingeben."
            continue
        fi
        ASK_FILE_RESULT="$file"
        return 0
    done
}

choose_image_host() {
    local mode="${1:-start}"
    local rows=() row
    local -a opts=() kinds=()
    local dev size fstype label mnt display
    local zero_label
    local choice i sel srcdev

    while true; do
        rows=()
        opts=()
        kinds=()
        while IFS= read -r row; do
            rows+=("$row")
        done < <(list_fs_volumes)

        echo
        print_heading "Image-Host-Ordner wählen:"
        if [[ -n "$IMAGE_HOST_DIR" ]]; then
            print_kv_path "Aktuell:     " "$IMAGE_HOST_DIR"
        fi
        print_text "Laufwerk/Ordner, unter dem Images liegen oder entstehen:"
        echo

        if [[ "${#rows[@]}" -gt 0 ]]; then
            for i in "${!rows[@]}"; do
                IFS='|' read -r dev size fstype label mnt <<<"${rows[$i]}"
                display="${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [${fstype:-?}]"
                if [[ -n "$label" ]]; then
                    display="$display '$label'"
                fi
                if [[ -n "$mnt" ]]; then
                    display="$display  (eingehängt: $mnt)"
                else
                    display="$display  (nicht eingehängt)"
                fi
                opts+=("$display")
                kinds+=("dev:$dev")
            done
        else
            print_warn "Keine Datenträger mit Dateisystem gefunden."
        fi
        opts+=("Pfad manuell eingeben")
        kinds+=("manual")

        for i in "${!opts[@]}"; do
            printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${opts[$i]}"
        done

        zero_label="Zurück"
        if [[ "$mode" == "start" ]]; then
            zero_label="Überspringen (keinen Host-Ordner festlegen)"
        fi
        printf '%b\n' "${COLOR_OTHER}0)${COLOR_RESET} ${zero_label}   ${COLOR_OTHER}00)${COLOR_RESET} Beenden   ${COLOR_OTHER}000)${COLOR_RESET} Abbrechen"
        echo

        print_prompt "Auswahl: "
        if ! read -r choice; then
            die "Vom Benutzer abgebrochen."
        fi
        if [[ "$choice" == "0" ]]; then
            if [[ "$mode" == "start" ]]; then
                IMAGE_HOST_DIR=""
                return 0
            fi
            exit 0
        fi
        if [[ "$choice" == "00" ]]; then
            menu_quit
        fi
        if [[ "$choice" == "000" ]]; then
            user_abort
        fi
        if [[ "$choice" =~ ^[0-9]+$ ]] &&
            ((choice >= 1 && choice <= ${#opts[@]})); then
            sel="${kinds[$((choice - 1))]}"
            if [[ "$sel" == "manual" ]]; then
                print_prompt "Pfad zum Image-Host-Ordner: "
                if ! read -r sel; then
                    die "Vom Benutzer abgebrochen."
                fi
                if [[ -z "$sel" ]]; then
                    print_text "Kein Pfad angegeben."
                    continue
                fi
                if [[ ! -d "$sel" ]]; then
                    print_warn "Verzeichnis nicht gefunden: $sel"
                    continue
                fi
                IMAGE_HOST_DIR="${sel%/}"
                srcdev="$(df -P "$IMAGE_HOST_DIR" 2>/dev/null | awk 'NR == 2 { print $1 }')"
                if [[ "$srcdev" == /dev/* ]]; then
                    host_dir_upgrade_driver "$srcdev" "$IMAGE_HOST_DIR"
                    IMAGE_HOST_DIR="$HOST_MOUNT"
                fi
            else
                if ! host_dir_for_device "${sel#dev:}"; then
                    continue
                fi
                IMAGE_HOST_DIR="$HOST_MOUNT"
            fi
            if [[ ! -w "$IMAGE_HOST_DIR" ]]; then
                print_warn "Image-Host-Ordner ist nicht beschreibbar – nur Wiederherstellen möglich."
            fi
            print_kv_path "Image-Host-Ordner: " "$IMAGE_HOST_DIR"
            host_dir_persist
            if [[ "$mode" == "menu" ]]; then
                exit 43
            fi
            return 0
        fi
        print_text "Ungültige Auswahl."
    done
}

collect_image_files() {
    local dir="$1" f

    IMG_FILES=()
    IMG_NAMES=()
    for f in "$dir"/*.img "$dir"/*.img.zst "$dir"/*.img.xz "$dir"/*.img.gz \
        "$dir"/*.img.enc "$dir"/*.img.zst.enc "$dir"/*.img.xz.enc \
        "$dir"/*.img.gz.enc "$dir"/*.tar; do
        [[ -f "$f" ]] || continue
        IMG_FILES+=("$f")
        IMG_NAMES+=("$(basename "$f")")
    done
}

choose_image_from_host() {
    local sub sel sel_dir
    local -a subdirs=() opts=() paths=()

    while true; do
        subdirs=()
        for sub in "$IMAGE_HOST_DIR"/*/; do
            [[ -d "$sub" ]] || continue
            sub="${sub%/}"
            subdirs+=("$(basename "$sub")")
        done

        if [[ "${#subdirs[@]}" -gt 0 ]]; then
            opts=("${subdirs[@]}")
            paths=("${subdirs[@]}")
            opts+=("Pfad manuell eingeben")
            paths+=("MANUAL")
            menu_choose "Unterordner im Image-Host-Ordner wählen:" "${opts[@]}"
            sel="${paths[$SELECTED_ITEM_INDEX]}"
            if [[ "$sel" == "MANUAL" ]]; then
                ask_image_file "Pfad zum Image (.zst/.xz/.gz/.img/.tar; verschlüsselt mit .enc): "
                SELECTED_IMAGE_FILE="$ASK_FILE_RESULT"
                return 0
            fi
            sel_dir="${IMAGE_HOST_DIR%/}/$sel"
            collect_image_files "$sel_dir"
            if [[ "${#IMG_FILES[@]}" -gt 0 ]]; then
                menu_choose "Image-Datei in '$sel' wählen:" "${IMG_NAMES[@]}"
                SELECTED_IMAGE_FILE="${IMG_FILES[$SELECTED_ITEM_INDEX]}"
                return 0
            fi
            print_warn "Keine Images im Unterordner gefunden: $sel_dir"
            print_text "Bitte erneut wählen."
        else
            print_warn "Keine Unterordner im Image-Host-Ordner: $IMAGE_HOST_DIR"
            collect_image_files "$IMAGE_HOST_DIR"
            if [[ "${#IMG_FILES[@]}" -gt 0 ]]; then
                menu_choose "Image-Datei im Image-Host-Ordner wählen:" "${IMG_NAMES[@]}"
                SELECTED_IMAGE_FILE="${IMG_FILES[$SELECTED_ITEM_INDEX]}"
                return 0
            fi
            print_prompt "Pfad zum Image (.zst/.xz/.gz/.img/.tar; verschlüsselt mit .enc): "
            read -r sel
            ask_image_file "Pfad zum Image (.zst/.xz/.gz/.img/.tar; verschlüsselt mit .enc): "
            SELECTED_IMAGE_FILE="$ASK_FILE_RESULT"
            return 0
        fi
    done
}


list_disks() {
    lsblk -d -e 7 -o PATH,SIZE,TYPE,MODEL -P 2>/dev/null |
        awk -F'"' '$0 ~ /TYPE="disk"/ { printf "%s|%s|%s\n", $2, $4, $6 }'
}

choose_disk() {
    local purpose="$1"
    local rows=()
    local row
    local display

    while IFS= read -r row; do
        rows+=("$row")
    done < <(list_disks)

    if [[ "${#rows[@]}" -eq 0 ]]; then
        die "Keine Festplatten gefunden (lsblk leer)."
    fi

    local options=()
    local paths=()
    for row in "${rows[@]}"; do
        IFS='|' read -r dev size model <<<"$row"
        paths+=("$dev")
        if [[ -n "$model" ]]; then
            display="${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  (${model})"
        else
            display="${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}"
        fi
        options+=("$display")
    done

    echo
    menu_choose "Festplatte wählen ($purpose):" "${options[@]}"
    SELECTED_DISK="${paths[$SELECTED_ITEM_INDEX]}"
}


list_partitions() {
    local disk="${1:-}"

    if [[ -n "$disk" ]]; then
        lsblk -rno PATH,SIZE,TYPE "$disk" 2>/dev/null |
            awk '$3 == "part" { print $1 "|" $2 }'
    else
        lsblk -rno PATH,SIZE,TYPE 2>/dev/null |
            awk '$3 == "part" { print $1 "|" $2 }'
    fi
}

choose_partition() {
    local purpose="$1"
    local disk="${2:-}"
    local rows=()
    local row
    local dev size fs
    local options=()
    local paths=()

    while IFS= read -r row; do
        rows+=("$row")
    done < <(list_partitions "$disk")

    if [[ "${#rows[@]}" -eq 0 ]]; then
        die "Keine Partitionen gefunden ($purpose)."
    fi

    for row in "${rows[@]}"; do
        IFS='|' read -r dev size <<<"$row"
        fs="$(fs_of_part "$dev")"
        paths+=("$dev")
        if [[ -n "$fs" ]]; then
            options+=("${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [$fs]")
        else
            options+=("${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [kein FS]")
        fi
    done

    menu_choose "Partition wählen ($purpose):" "${options[@]}"
    SELECTED_PART="${paths[$SELECTED_ITEM_INDEX]}"
}

choose_partition_any() {
    local purpose="$1"
    local rows=()
    local row dev size fs
    local paths=()
    local i input n
    local first_disk

    while IFS= read -r row; do
        rows+=("$row")
    done < <(list_partitions "")

    if [[ "${#rows[@]}" -eq 0 ]]; then
        die "Keine Partitionen gefunden ($purpose)."
    fi

    echo
    print_heading "Partition(en) wählen ($purpose):"
    for i in "${!rows[@]}"; do
        IFS='|' read -r dev size <<<"${rows[$i]}"
        fs="$(fs_of_part "$dev")"
        paths+=("$dev")
        if [[ -n "$fs" ]]; then
            printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [${fs}]"
        else
            printf '%b\n' "${COLOR_OTHER}$((i + 1)))${COLOR_RESET} ${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [kein FS]"
        fi
    done
    echo
    print_text "Eine Partition (z. B. 3) ODER mehrere (z. B. 3,4,5,6 oder 4-7) angeben."
    print_text "Mehrere werden in EIN Image gesichert und daraus einzeln wiederherstellbar."
    echo

    while true; do
        print_prompt "Auswahl (0 = zurück, 00 = beenden, 000 = abbrechen): "
        if ! read -r input; then
            die "Vom Benutzer abgebrochen."
        fi
        input="${input//[[:space:]]/}"

        if [[ "$input" == "0" ]]; then
            exit 0
        fi
        if [[ "$input" == "00" ]]; then
            menu_quit
        fi
        if [[ "$input" == "000" ]]; then
            user_abort
        fi

        if [[ -z "$input" ]]; then
            print_text "Ungültige Auswahl."
            continue
        fi

        if [[ "$input" =~ ^[0-9]+$ ]] &&
            ((input >= 1 && input <= ${#paths[@]})); then
            SELECTED_PART="${paths[$((input - 1))]}"
            PART_MULTI=0
            return 0
        fi

        if [[ "$input" == *","* || "$input" == *"-"* ]] &&
            parse_selection "$input" "${#paths[@]}"; then

            if [[ "${#SELECTED_NUMBERS[@]}" -eq 1 ]]; then
                SELECTED_PART="${paths[$((SELECTED_NUMBERS[0] - 1))]}"
                PART_MULTI=0
                return 0
            fi

            first_disk="$(source_disk_of_part "${paths[$((SELECTED_NUMBERS[0] - 1))]}")"
            PART_MULTI_PATHS=()
            for n in "${SELECTED_NUMBERS[@]}"; do
                dev="${paths[$((n - 1))]}"
                if [[ "$(source_disk_of_part "$dev")" != "$first_disk" ]]; then
                    die "Mehrfachauswahl muss auf EINER Platte liegen – $dev liegt nicht auf $first_disk. Bitte mehrere Platten einzeln sichern."
                fi
                PART_MULTI_PATHS+=("$dev")
            done
            PART_MULTI_DISK="$first_disk"
            PART_MULTI=1
            return 0
        fi

        print_text "Ungültige Auswahl."
    done
}

dev_size_bytes() {
    local size

    size="$(blockdev --getsize64 "$1" 2>/dev/null)" ||
        die "Größe von $1 konnte nicht ermittelt werden."

    printf '%s' "$size"
}

fmt_size() {
    local bytes="$1"

    if command_exists numfmt; then
        numfmt --to=iec --suffix=B "$bytes"
    else
        awk -v b="$bytes" 'BEGIN { printf "%.1fGiB", b / 1073741824 }'
    fi
}

fs_of_part() {
    local out

    out="$(blkid -o value -s TYPE "$1" 2>/dev/null | awk 'NR == 1 { print; exit }')"
    if [[ -n "$out" ]]; then
        printf '%s' "$out"
        return 0
    fi

    blkid "$1" 2>/dev/null | awk -F'"' '/TYPE=/ { print $2; exit }'
}

source_disk_of_part() {
    local pkname

    pkname="$(lsblk -no PKNAME "$1" 2>/dev/null | awk 'NF { print $1; exit }')"

    if [[ -n "$pkname" ]]; then
        printf '/dev/%s' "$pkname"
    else
        printf '%s' "$1"
    fi
}

ensure_not_mounted() {
    local dev="$1"
    local mounts=()
    local m

    while IFS= read -r m; do
        [[ -n "$m" ]] && mounts+=("$m")
    done < <(lsblk -no MOUNTPOINTS "$dev" 2>/dev/null || true)

    if [[ "${#mounts[@]}" -gt 0 ]]; then
        die "$dev ist eingehängt (${mounts[*]}) – bitte vorher aushängen."
    fi
}

ensure_disk_not_mounted() {
    local disk="$1"
    local part

    ensure_not_mounted "$disk"

    while IFS='|' read -r part _; do
        ensure_not_mounted "$part"
    done < <(list_partitions "$disk")
}

target_parent_disk() {
    local dir="$1"
    local srcdev
    local pkname

    srcdev="$(df -P "$dir" 2>/dev/null | awk 'NR == 2 { print $1 }')"
    [[ -n "$srcdev" ]] || { printf ''; return 0; }
    [[ -b "$srcdev" ]] || { printf ''; return 0; }

    pkname="$(lsblk -no PKNAME "$srcdev" 2>/dev/null | awk 'NF { print $1; exit }')"

    if [[ -n "$pkname" ]]; then
        printf '/dev/%s' "$pkname"
    else
        printf '%s' "$srcdev"
    fi
}


warn_windows_source() {
    local dev="$1"
    local part
    local fs
    local has_ntfs=0
    local is_disk=0

    if [[ "$(lsblk -rno TYPE "$dev" 2>/dev/null | awk 'NR == 1 { print $1 }')" == "disk" ]]; then
        is_disk=1
    fi

    if [[ "$is_disk" -eq 1 ]]; then
        while IFS='|' read -r part _; do
            fs="$(fs_of_part "$part")"
            [[ "$fs" == "ntfs" ]] && has_ntfs=1
        done < <(list_partitions "$dev")
    else
        fs="$(fs_of_part "$dev")"
        [[ "$fs" == "ntfs" ]] && has_ntfs=1
    fi

    if [[ "$has_ntfs" -eq 1 ]]; then
        echo
        print_warn "WARNUNG: Windows-/NTFS-Partition(en) erkannt."
        print_warn "  - Windows 'Schnellstart'/Ruhezustand lässt NTFS in einem"
        print_warn "    inkonsistenten Zustand zurück -> Kopie kann beschädigt sein."
        print_warn "    Windows vorher VOLL herunterfahren: 'shutdown /s /t 0'"
        print_warn "    (Schnellstart dauerhaft aus: 'powercfg /h off' in Windows)"
        print_warn "  - BitLocker-Platten werden 1:1 mitkopiert; für den Zugriff auf"
        print_warn "    die Kopie wird der BitLocker-Wiederherstellungsschlüssel gebraucht."
        print_warn "  - MSR-/Recovery-Partitionen werden von der 1:1-Kopie erfasst."
        echo
    fi
}


choose_compression() {
    local options=()
    local kinds=()

    if command_exists zstd; then
        options+=("zstd  Stufe 1  – schnellste Kompression, ideal für große Platten")
        kinds+=("zstd1")
        options+=("zstd  Stufe 3  – bester Kompromiss aus Tempo und Größe (Standard)")
        kinds+=("zstd3")
        options+=("zstd  Stufe 19 – maximale Verdichtung, deutlich langsamer")
        kinds+=("zstd19")
    fi

    if command_exists xz; then
        options+=("xz    Stufe 6  – hohe Verdichtung, langsam (multithreaded)")
        kinds+=("xz")
    fi

    if command_exists gzip; then
        options+=("gzip  Stufe 6  – klassisch, auf jedem System verfügbar")
        kinds+=("gzip")
    fi

    options+=("ohne           – Rohkopie (.img), schnellstes Schreiben, größte Datei")
    kinds+=("none")

    local ci
    MENU_DEFAULT_CHOICE="1"
    for ci in "${!kinds[@]}"; do
        if [[ "${kinds[$ci]}" == "zstd3" ]]; then
            MENU_DEFAULT_CHOICE=$((ci + 1))
        fi
    done

    menu_choose "Kompression wählen:" "${options[@]}"

    case "${kinds[$SELECTED_ITEM_INDEX]}" in
        zstd1)
            COMPRESSOR=(zstd -T0 -q -1)
            DECOMPRESSOR=(zstd -d -q -c)
            IMAGE_SUFFIX=".zst"
            COMPRESSION="zstd Stufe 1 (multithreaded)"
            ;;
        zstd3)
            COMPRESSOR=(zstd -T0 -q -3)
            DECOMPRESSOR=(zstd -d -q -c)
            IMAGE_SUFFIX=".zst"
            COMPRESSION="zstd Stufe 3 (multithreaded)"
            ;;
        zstd19)
            COMPRESSOR=(zstd -T0 -q -19)
            DECOMPRESSOR=(zstd -d -q -c)
            IMAGE_SUFFIX=".zst"
            COMPRESSION="zstd Stufe 19 (multithreaded)"
            ;;
        xz)
            COMPRESSOR=(xz -T0 -q -6)
            DECOMPRESSOR=(xz -d -q -c)
            IMAGE_SUFFIX=".xz"
            COMPRESSION="xz Stufe 6 (multithreaded)"
            ;;
        gzip)
            COMPRESSOR=(gzip -6)
            DECOMPRESSOR=(gzip -d -c)
            IMAGE_SUFFIX=".gz"
            COMPRESSION="gzip Stufe 6"
            ;;
        none)
            COMPRESSOR=(cat)
            DECOMPRESSOR=(cat)
            IMAGE_SUFFIX=".img"
            COMPRESSION="ohne (Rohkopie)"
            ;;
    esac
}

decompressor_from_suffix() {
    local image="$1"

    DECRYPTOR=()
    case "$image" in
        *.enc)
            if ! command_exists openssl; then
                collect_missing required openssl
            fi
            DECRYPTOR=(openssl enc -d "${ENC_DECIPHER_ARGS[@]}" -pass env:CLONIE_ENC_PASS)
            image="${image%.enc}"
            ;;
    esac

    case "$image" in
        *.zst)
            command_exists zstd || die "zstd ist nicht installiert, kann $image nicht dekomprimieren."
            DECOMPRESSOR=(zstd -d -q -c)
            ;;
        *.xz)
            command_exists xz || die "xz ist nicht installiert, kann $image nicht dekomprimieren."
            DECOMPRESSOR=(xz -d -q -c)
            ;;
        *.gz)
            command_exists gzip || die "gzip ist nicht installiert, kann $image nicht dekomprimieren."
            DECOMPRESSOR=(gzip -d -c)
            ;;
        *)
            DECOMPRESSOR=(cat)
            ;;
    esac
}


require_openssl() {
    if ! command_exists openssl; then
        collect_missing required openssl
    fi
}

ask_passphrase() {
    local prompt="$1"
    local pw

    print_prompt "$prompt: "
    if ! read -r -s pw; then
        die "Vom Benutzer abgebrochen."
    fi
    printf '\n'
    case "$pw" in
        000) user_abort ;;
        00) menu_quit ;;
    esac
    ENC_PASSPHRASE="$pw"
}

ask_encryption() {
    local pw

    ENCRYPT_IMAGE=0
    ENC_PASSPHRASE=""
    echo
    if ! confirm "Image verschlüsseln (AES-256, Passwort)?" "N"; then
        return 0
    fi
    print_warn "ACHTUNG: Geht das Passwort verloren, sind die Daten UNWIEDERBRINGLICH verloren - es gibt keine Rettungsmöglichkeit mehr."
    require_openssl

    while true; do
        ask_passphrase "Passwort (nicht anzeigen)"
        pw="$ENC_PASSPHRASE"
        if [[ -z "$pw" ]]; then
            print_warn "Leeres Passwort – bitte erneut eingeben."
            continue
        fi
        if (( ${#pw} < 8 )); then
            confirm "Passwort ist kürzer als 8 Zeichen – trotzdem verwenden?" "N" && break
            continue
        fi
        break
    done
    while true; do
        ask_passphrase "Passwort wiederholen"
        if [[ "$ENC_PASSPHRASE" == "$pw" ]]; then
            break
        fi
        print_warn "Passwörter stimmen nicht überein – bitte erneut."
    done
    ENCRYPT_IMAGE=1
    ENC_PASSPHRASE="$pw"
    export CLONIE_ENC_PASS="$ENC_PASSPHRASE"
}

write_passcheck() {
    local out="$1"

    printf '%s' "$ENC_PASSCHECK_TOKEN" |
        openssl enc "${ENC_CIPHER_ARGS[@]}" -pass env:CLONIE_ENC_PASS -out "$out"
}

password_matches_passcheck() {
    local passcheck="$1"
    local have=""

    have="$(openssl enc -d "${ENC_DECIPHER_ARGS[@]}" -pass env:CLONIE_ENC_PASS -in "$passcheck" 2>/dev/null)" || return 1
    [[ "$have" == "$ENC_PASSCHECK_TOKEN" ]]
}

restore_ask_password() {
    local passcheck="${1:-}"
    local try=0

    echo
    if [[ -n "$passcheck" && -f "$passcheck" ]]; then
        while ((try < 3)); do
            ask_passphrase "Passwort für verschlüsseltes Image"
            export CLONIE_ENC_PASS="$ENC_PASSPHRASE"
            if password_matches_passcheck "$passcheck"; then
                return 0
            fi
            try=$((try + 1))
            print_warn "Passwort falsch (Passcheck fehlgeschlagen)."
        done
        die "Dreimal ein falsches Passwort – Abbruch."
    fi
    if [[ -n "$passcheck" ]]; then
        print_warn "Keine Passcheck-Datei gefunden: $passcheck – das Passwort kann vor dem Schreiben nicht verifiziert werden."
    else
        print_warn "Kein Passcheck im Image – das Passwort kann vor dem Schreiben nicht verifiziert werden."
    fi
    confirm "Ohne Passwortprüfung fortfahren?" "N" || die "Abgebrochen."
    ask_passphrase "Passwort für verschlüsseltes Image"
    export CLONIE_ENC_PASS="$ENC_PASSPHRASE"
}



create_image() {
    local kind="$1"
    local src=""
    local src_disk=""
    local src_size
    local image_dir
    local image_base
    local image_path
    local manifest
    local checksum
    local dir_disk
    local stamp n
    local pipeline_status
    local enc_suffix=""

    echo
    print_heading "=============================================="
    if [[ "$kind" == "disk" ]]; then
        print_heading "  Image von FESTPLATTE erstellen"
    else
        print_heading "  Image von PARTITION(EN) erstellen"
    fi
    print_heading "=============================================="
    echo

    if [[ "$kind" == "disk" ]]; then
        choose_disk "Quelle"
        src="$SELECTED_DISK"
        src_disk="$src"
        ensure_disk_not_mounted "$src"
    else
        choose_partition_any "Quelle"
        if [[ "$PART_MULTI" -eq 1 ]]; then
            multi_backup_run "$PART_MULTI_DISK" "${PART_MULTI_PATHS[@]}"
            return 0
        fi
        src="$SELECTED_PART"
        src_disk="$(source_disk_of_part "$src")"
        ensure_not_mounted "$src"
    fi

    src_size="$(dev_size_bytes "$src")"
    warn_windows_source "$src"

    choose_compression
    ask_encryption
    if ((ENCRYPT_IMAGE)); then
        enc_suffix=".enc"
    fi

    if host_dir_active; then
        ask_image_base "Name für den Sicherungsordner: "
        host_backup_dir "$ASK_BASE_RESULT"
        image_dir="$BACKUP_DIR"
        echo
        print_text "Gespeichert wird im Image-Host-Ordner, Unterordner:"
        print_kv_path "   " "$image_dir"
        [[ -w "$image_dir" ]] ||
            die "Zielverzeichnis ist nicht beschreibbar: $image_dir"
        dir_disk="$(target_parent_disk "$image_dir")"
        if [[ -n "$dir_disk" && "$dir_disk" == "$src_disk" ]]; then
            die "Zielverzeichnis liegt auf der Quellplatte ($src_disk) – das Schreiben würde die Quelle zerstören. Bitte ein Verzeichnis auf einer ANDEREN Platte wählen."
        fi
        stamp="$(date +%Y%m%d-%H%M%S)"
        image_base="$(basename "$src_disk")_${stamp}"
        n=2
        while [[ -e "${image_dir%/}/${image_base}${IMAGE_SUFFIX}${enc_suffix}" ]]; do
            image_base="$(basename "$src_disk")_${stamp}_${n}"
            n=$((n + 1))
        done
        image_path="${image_dir%/}/${image_base}${IMAGE_SUFFIX}${enc_suffix}"
    else
        echo
        print_text "Wohin soll das Image gespeichert werden?"
        print_warn "WICHTIG: NICHT auf die Quellplatte ($src_disk) selbst!"
        echo
        ask_target_dir "$src_disk"
        image_dir="$ASK_DIR_RESULT"
        while true; do
            ask_image_base
            image_base="$ASK_BASE_RESULT"
            image_path="${image_dir%/}/${image_base}${IMAGE_SUFFIX}${enc_suffix}"
            if [[ ! -e "$image_path" ]]; then
                break
            fi
            print_warn "Image existiert bereits: $image_path – bitte anderen Namen wählen."
        done
    fi
    manifest="${image_path}.manifest.txt"
    checksum="${image_path}.sha256"

    echo
    print_kv_path "Quelle:       " "$src"
    print_kv "Größe:         $(fmt_size "$src_size")"
    print_kv "Kompression:   $COMPRESSION"
    if ((ENCRYPT_IMAGE)); then
        print_kv "Verschlüsselung: AES-256-CTR (openssl, PBKDF2, $ENC_ITER Iterationen)"
    fi
    print_kv_path "Image:        " "$image_path"
    echo

    confirm "Image-Erstellung wirklich starten?" "N" ||
        { print_text "Abgebrochen."; return 0; }

    {
        printf 'Erstellt: '
        date -Iseconds 2>/dev/null || date
        printf 'Quelle: %s\n' "$src"
        printf 'Quellgröße_bytes: %s\n' "$src_size"
        printf 'Kompression: %s\n' "$COMPRESSION"
        if ((ENCRYPT_IMAGE)); then
            printf 'Verschlüsselung: AES-256-CTR (openssl, PBKDF2, %s Iterationen)\n' "$ENC_ITER"
        fi
        printf 'Blockgröße: %s\n\n' "$BLOCK_SIZE"
        if [[ "$kind" == "disk" ]]; then
            echo "Partitionen:"
            lsblk -o NAME,PATH,SIZE,TYPE,FSTYPE,LABEL,PARTLABEL "$src" 2>/dev/null
            echo
            echo "Partitionstabelle (sfdisk-Dump):"
            sfdisk -d "$src" 2>/dev/null || true
        fi
    } > "$manifest"

    print_other "Image-Erstellung läuft ..."

    if ((ENCRYPT_IMAGE)); then
        write_passcheck "${image_path}.passcheck" ||
            die "Passcheck-Datei (${image_path}.passcheck) konnte nicht erstellt werden."
        set +e
        dd \
            if="$src" \
            bs="$BLOCK_SIZE" \
            ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
            ${DD_STATUS[@]+"${DD_STATUS[@]}"} |
            "${COMPRESSOR[@]}" |
            openssl enc "${ENC_CIPHER_ARGS[@]}" -pass env:CLONIE_ENC_PASS > "$image_path"
        pipeline_status=("${PIPESTATUS[@]}")
        set -e

        if ((pipeline_status[0] != 0 || pipeline_status[1] != 0 || pipeline_status[2] != 0)); then
            rm -f -- "$image_path" "${image_path}.passcheck"
            die "Image-Erstellung fehlgeschlagen (dd=${pipeline_status[0]}, Kompressor=${pipeline_status[1]}, Verschlüsselung=${pipeline_status[2]})."
        fi
    else
        set +e
        dd \
            if="$src" \
            bs="$BLOCK_SIZE" \
            ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
            ${DD_STATUS[@]+"${DD_STATUS[@]}"} |
            "${COMPRESSOR[@]}" > "$image_path"
        pipeline_status=("${PIPESTATUS[@]}")
        set -e

        if ((pipeline_status[0] != 0 || pipeline_status[1] != 0)); then
            rm -f -- "$image_path"
            die "Image-Erstellung fehlgeschlagen (dd=${pipeline_status[0]}, Kompressor=${pipeline_status[1]})."
        fi
    fi

    sync

    print_text "SHA-256-Prüfsumme wird berechnet ..."
    sha256sum "$image_path" > "$checksum"

    echo
    print_other "Image erfolgreich erstellt:"
    print_kv_path "   Image:        " "$image_path"
    print_kv_path "   Manifest:     " "$manifest"
    print_kv_path "   Prüfsumme:    " "$checksum"
    if ((ENCRYPT_IMAGE)); then
        print_kv_path "   Passcheck:    " "${image_path}.passcheck"
    fi
}


restore_image() {
    local image=""

    echo
    print_heading "=============================================="
    print_heading "  Image ZURÜCKSPIELEN (recover)"
    print_heading "=============================================="
    echo

    if host_dir_active; then
        choose_image_from_host
        image="$SELECTED_IMAGE_FILE"
    else
        ask_image_file "Pfad zum Image (.zst/.xz/.gz/.img/.tar; verschlüsselt mit .enc): "
        image="$ASK_FILE_RESULT"
    fi

    case "$image" in
        *.tar)
            print_text "Partitions-Image erkannt – Wiederherstellung läuft über den Multi-Restore."
            multi_restore_run "$image"
            return 0
            ;;
    esac

    restore_image_run "$image"
}

restore_image_run() {
    local image="$1"
    local manifest
    local src_size=""
    local target_kind=""
    local tgt=""
    local tgt_disk=""
    local tgt_size
    local pipeline_status

    [[ -f "$image" ]] || die "Image nicht gefunden: $image"

    case "$image" in
        *.tar)
            die "Mehrpartitions-Image erkannt – 'Image zurückspielen (recover)' routet .tar automatisch an den Multi-Restore."
            ;;
    esac

    manifest="${image}.sha256"

    if [[ -f "$manifest" ]]; then
        print_text "Prüfsumme wird geprüft ..."
        (
            cd "$(dirname "$image")" &&
                sha256sum -c "$(basename "$image").sha256"
        ) || die "Prüfsumme stimmt nicht – Image beschädigt oder falsches Ziel."
    else
        print_warn "Keine Prüfsumme gefunden: $manifest"
        confirm "Ohne Prüfsummenprüfung fortfahren?" "N" ||
            die "Abgebrochen."
    fi

    decompressor_from_suffix "$image"

    if (( ${#DECRYPTOR[@]} > 0 )); then
        print_text "Verschlüsseltes Image erkannt (AES-256)."
        restore_ask_password "${image}.passcheck"
    fi

    if [[ -f "${image}.manifest.txt" ]]; then
        src_size="$(awk -F': ' '$1 == "Quellgröße_bytes" { print $2; exit }' "${image}.manifest.txt")"
    fi

    echo
    menu_choose "Zielart wählen:" "Auf ganze FESTPLATTE zurückspielen" "Auf einzelne PARTITION zurückspielen"
    if [[ "$SELECTED_ITEM_INDEX" -eq 0 ]]; then
        target_kind="disk"
        choose_disk "Ziel"
        tgt="$SELECTED_DISK"
        tgt_disk="$tgt"
        ensure_disk_not_mounted "$tgt"
    else
        target_kind="part"
        choose_partition "Ziel"
        tgt="$SELECTED_PART"
        tgt_disk="$(source_disk_of_part "$tgt")"
        ensure_not_mounted "$tgt"
    fi

    tgt_size="$(dev_size_bytes "$tgt")"

    if [[ -n "$src_size" ]] && ((tgt_size < src_size)); then
        die "Ziel ($tgt) ist zu klein: $(fmt_size "$tgt_size") < Quellgröße $(fmt_size "$src_size")."
    fi

    echo
    print_kv_path "Image:        " "$image"
    print_kv_path "Ziel:         " "$tgt"
    print_kv "Zielgröße:     $(fmt_size "$tgt_size")"
    echo
    print_warn "ACHTUNG: Der komplette Inhalt von $tgt wird UNWIDERRUFLICH überschrieben!"
    echo

    confirm "Wirklich zurückspielen?" "N" || die "Vom Benutzer abgebrochen."

    print_other "Wiederherstellung läuft ..."

    if (( ${#DECRYPTOR[@]} > 0 )); then
        set +e
        "${DECRYPTOR[@]}" -in "$image" |
            "${DECOMPRESSOR[@]}" |
            dd of="$tgt" bs="$BLOCK_SIZE" conv=fsync \
                ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
                ${DD_STATUS[@]+"${DD_STATUS[@]}"}
        pipeline_status=("${PIPESTATUS[@]}")
        set -e

        if ((pipeline_status[0] != 0 || pipeline_status[1] != 0 || pipeline_status[2] != 0)); then
            die "Wiederherstellung fehlgeschlagen (Entschlüsselung=${pipeline_status[0]}, Dekompressor=${pipeline_status[1]}, dd=${pipeline_status[2]})."
        fi
    else
        set +e
        "${DECOMPRESSOR[@]}" "$image" |
            dd of="$tgt" bs="$BLOCK_SIZE" conv=fsync \
                ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
                ${DD_STATUS[@]+"${DD_STATUS[@]}"}
        pipeline_status=("${PIPESTATUS[@]}")
        set -e

        if ((pipeline_status[0] != 0 || pipeline_status[1] != 0)); then
            die "Wiederherstellung fehlgeschlagen (Dekompressor=${pipeline_status[0]}, dd=${pipeline_status[1]})."
        fi
    fi

    sync

    if [[ "$target_kind" == "disk" ]]; then
        partprobe "$tgt" 2>/dev/null || true
    fi

    echo
    print_other "Image erfolgreich zurückgespielt auf $tgt."

    if [[ -z "$src_size" ]] || ((tgt_size > src_size)); then
        offer_resize "$target_kind" "$tgt" "$tgt_disk"
    fi
}



clone_dd_error_hint() {
    print_warn "dd-Meldung oben nennt die Fehlerseite: 'error reading' = Quelle, 'error writing' = Ziel."
    print_warn "Ziel ist jetzt UNVOLLSTÄNDIG überschrieben (nicht bootbar) – Klon nach Fehlerbehebung wiederholen."
    print_warn "Diagnose: Kernel-Log (dmesg) auf Gerätefehler prüfen; in einer VM: Speicherplatz des Hosts prüfen."
}

clone_disk_flow() {
    local src
    local tgt
    local src_size
    local tgt_size
    local pipeline_status

    echo
    print_heading "=============================================="
    print_heading "  FESTPLATTE 1:1 KLONEN"
    print_heading "=============================================="
    echo

    choose_disk "Quelle"
    src="$SELECTED_DISK"
    src_size="$(dev_size_bytes "$src")"

    warn_windows_source "$src"

    echo
    print_warn "Zielplatte wird VOLLSTÄNDIG überschrieben!"
    choose_disk "Ziel"
    tgt="$SELECTED_DISK"

    [[ "$tgt" != "$src" ]] ||
        die "Quelle und Ziel sind identisch ($src)."

    tgt_size="$(dev_size_bytes "$tgt")"

    if ((tgt_size < src_size)); then
        die "Zielplatte zu klein: $(fmt_size "$tgt_size") < Quelle $(fmt_size "$src_size")."
    fi

    ensure_disk_not_mounted "$src"
    ensure_disk_not_mounted "$tgt"
    warn_windows_source "$tgt" || true

    echo
    print_kv_path "Quelle:  " "$src"
    print_kv "Größe:    $(fmt_size "$src_size")"
    print_kv_path "Ziel:    " "$tgt"
    print_kv "Größe:    $(fmt_size "$tgt_size")"
    echo
    print_warn "ACHTUNG: ALLE Daten auf $tgt werden UNWIDERRUFLICH gelöscht!"
    echo

    confirm "Klonen wirklich starten?" "N" || die "Vom Benutzer abgebrochen."

    print_other "Kopiervorgang läuft ..."

    set +e
    dd if="$src" of="$tgt" bs="$BLOCK_SIZE" conv=fsync \
        ${DD_FULLBLOCK[@]+"${DD_FULLBLOCK[@]}"} \
        ${DD_STATUS[@]+"${DD_STATUS[@]}"}
    pipeline_status=("${PIPESTATUS[@]}")
    set -e

    if ((pipeline_status[0] != 0 || pipeline_status[1] != 0)); then
        clone_dd_error_hint
        die "Klonen fehlgeschlagen (dd Exit ${pipeline_status[0]})."
    fi

    sync
    partprobe "$tgt" 2>/dev/null || true

    echo
    print_other "Festplatte erfolgreich geklont: $src -> $tgt"

    if ((tgt_size > src_size)); then
        print_text "Die Zielplatte ist größer als die Quelle."
        offer_resize "disk" "$tgt" "$tgt"
    fi
}

clone_partition_flow() {
    local src
