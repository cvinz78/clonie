    local -a selection=(-e 7)
    if [[ "${1:-}" == "alle" ]]; then
        selection=()
    fi
    lsblk "${selection[@]}" -o PATH,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT -P 2>/dev/null |
        awk -F'"' '
            $0 ~ /TYPE="disk"/ || $0 ~ /TYPE="part"/ {
                printf "%s|%s|%s|%s|%s\n", $2, $4, $8, $10, $12
            }'
}

rescan_disks() {
    local -a disks=()
    local -a rows=()
    local row dev size fstype label mnt display

    print_other "Lese Festplatten/Partitionstabellen erneut ein ..."
    while IFS= read -r row; do
        disks+=("$row")
    done < <(lsblk -drno PATH,TYPE 2>/dev/null | awk '$2 == "disk" { print $1 }')
    for dev in "${disks[@]}"; do
        partprobe "$dev" 2>/dev/null || true
    done
    if command_exists udevadm; then
        udevadm settle 2>/dev/null || true
    fi

    while IFS= read -r row; do
        rows+=("$row")
    done < <(list_fs_volumes alle)

    echo
    print_heading "Aktuelle Datenträger:"
    if [[ "${#rows[@]}" -eq 0 ]]; then
        print_warn "Keine Datenträger mit Dateisystem gefunden."
        return 0
    fi
    for row in "${rows[@]}"; do
        IFS='|' read -r dev size fstype label mnt <<<"$row"
        display="${COLOR_TEXT}${dev}${COLOR_RESET}  ${size}  [${fstype:-?}]"
        if [[ -n "$label" ]]; then
            display="$display '$label'"
        fi
        if [[ -n "$mnt" ]]; then
            display="$display  (eingehängt: $mnt)"
        else
            display="$display  (nicht eingehängt)"
        fi
        printf '%b\n' "${COLOR_OTHER}-${COLOR_RESET} $display"
    done
    return 0
}

mount_driver_of_dir() {
    local dir="$1" srcdev

    srcdev="$(df -P "$dir" 2>/dev/null | awk 'NR == 2 { print $1 }')"
    [[ -n "$srcdev" ]] || return 0
    awk -v dev="$srcdev" '$1 == dev { print $3; exit }' /proc/mounts
}

mount_host_device() {
    local dev="$1" mnt="$2"
    local fstype driver

    fstype="$(fs_of_part "$dev")"
    if [[ "$fstype" == "ntfs" ]] && mount -t ntfs3 "$dev" "$mnt" 2>/dev/null; then
        print_other "$dev eingehängt unter $mnt (ntfs3, Kernel-Treiber)"
        return 0
    fi
    if ! mount "$dev" "$mnt" 2>/dev/null; then
        return 1
    fi
    driver="$(mount_driver_of_dir "$mnt")"
    if [[ "$fstype" == "ntfs" && "$driver" == "fuseblk" ]]; then
        print_warn "Kernel-Modul ntfs3 nicht verfügbar – $dev läuft als ntfs-3g (FUSE)."
        print_warn "Schreibrate deutlich geringer (ca. 30–100 MB/s statt ~500 MB/s)."
    else
        print_other "$dev eingehängt unter $mnt"
    fi
    return 0
}

host_dir_upgrade_driver() {
    local dev="$1" mnt="$2"
    local driver newmnt created

    HOST_MOUNT="$mnt"
    driver="$(mount_driver_of_dir "$mnt")"
    [[ "$driver" == "fuseblk" ]] || return 0
    echo
    print_warn "$mnt läuft mit ntfs-3g (FUSE) – Schreibrate deutlich geringer (ca. 30–100 MB/s)."
    if ! confirm "Mit ntfs3 (Kernel-Treiber) neu einhängen?" "J"; then
        return 0
    fi
    newmnt="/mnt/clonie-$(basename "$dev")"
    created=0
    if [[ ! -e "$newmnt" ]]; then
        created=1
    fi
    if ! mkdir -p "$newmnt"; then
        print_warn "Mountpoint konnte nicht erstellt werden: $newmnt"
        return 0
    fi
    if ! umount "$mnt" 2>/dev/null; then
        print_warn "Aushängen fehlgeschlagen ($mnt belegt) – ntfs-3g wird weiter verwendet."
        if [[ "$created" == "1" ]]; then
            rmdir "$newmnt" 2>/dev/null || true
        fi
        return 0
    fi
    if mount -t ntfs3 "$dev" "$newmnt" 2>/dev/null; then
        print_other "$dev eingehängt unter $newmnt (ntfs3, Kernel-Treiber)"
        HOST_MOUNT="$newmnt"
        MOUNTED_BY_CLONIE+=("$newmnt")
        MOUNTED_CREATED+=("$created")
        return 0
    fi
    print_warn "Einhängen mit ntfs3 fehlgeschlagen."
    if mount "$dev" "$newmnt" 2>/dev/null; then
        print_warn "$dev läuft weiter mit ntfs-3g (FUSE)."
        HOST_MOUNT="$newmnt"
        MOUNTED_BY_CLONIE+=("$newmnt")
        MOUNTED_CREATED+=("$created")
        return 0
    fi
    print_warn "$dev ist ausgehängt – manuell einhängen (z. B. sudo mount -t ntfs3 $dev $newmnt)."
    if [[ "$created" == "1" ]]; then
        rmdir "$newmnt" 2>/dev/null || true
    fi
}

host_dir_for_device() {
    local dev="$1"
    local mnt

    mnt="$(lsblk -rno MOUNTPOINT "$dev" 2>/dev/null | awk 'NF { print; exit }')" || mnt=""
    if [[ -n "$mnt" ]]; then
        host_dir_upgrade_driver "$dev" "$mnt"
        return 0
    fi

    print_text "$dev ist nicht eingehängt."
    if ! confirm "$dev jetzt einhängen (als Image-Host-Ordner)?" "J"; then
        print_text "Übersprungen – $dev wird nicht verwendet."
        return 1
    fi
    mnt="/mnt/clonie-$(basename "$dev")"
    local created=0
    if [[ ! -e "$mnt" ]]; then
        created=1
    fi
    if ! mkdir -p "$mnt"; then
        print_warn "Mountpoint konnte nicht erstellt werden: $mnt"
        return 1
    fi
    if ! mount_host_device "$dev" "$mnt"; then
        if [[ "$created" == "1" ]]; then
            rmdir "$mnt" 2>/dev/null || true
        fi
        print_warn "Einhängen von $dev fehlgeschlagen (Dateisystem nicht unterstützt?)."
        return 1
    fi
    HOST_MOUNT="$mnt"
    MOUNTED_BY_CLONIE+=("$mnt")
    MOUNTED_CREATED+=("$created")
    return 0
}

host_dir_persist() {
    local i
    [[ -n "${HOST_DIR_STATE:-}" ]] || return 0
    printf '%s\n' "$IMAGE_HOST_DIR" > "$HOST_DIR_STATE"
    for i in "${!MOUNTED_BY_CLONIE[@]}"; do
        printf 'M\t%s\t%s\n' \
            "${MOUNTED_BY_CLONIE[$i]}" "${MOUNTED_CREATED[$i]:-0}" >> "$HOST_DIR_STATE"
    done
}

host_dir_reload() {
    local line mnt created known i
    local first=1
    IMAGE_HOST_DIR=""
    if [[ -z "${HOST_DIR_STATE:-}" || ! -s "$HOST_DIR_STATE" ]]; then
        return 0
    fi
    while IFS= read -r line; do
        if [[ "$first" == 1 ]]; then
            IMAGE_HOST_DIR="$line"
            first=0
            continue
        fi
        [[ "$line" == M$'\t'* ]] || continue
        mnt="${line#M$'\t'}"
        created="${mnt##*$'\t'}"
        mnt="${mnt%%$'\t'*}"
        known=0
        for i in "${!MOUNTED_BY_CLONIE[@]}"; do
            if [[ "${MOUNTED_BY_CLONIE[$i]}" == "$mnt" ]]; then
                known=1
                break
            fi
        done
        if [[ "$known" == 0 ]]; then
            MOUNTED_BY_CLONIE+=("$mnt")
            MOUNTED_CREATED+=("$created")
        fi
    done < "$HOST_DIR_STATE"
}

host_dir_active() {
    [[ -n "$IMAGE_HOST_DIR" && -d "$IMAGE_HOST_DIR" ]]
}

host_backup_dir() {
    local ordner_name="$1"
    local stamp

    [[ -n "$IMAGE_HOST_DIR" && -d "$IMAGE_HOST_DIR" ]] || return 1
    stamp="$(date +%Y%m%d-%H%M%S)"
    BACKUP_DIR="${IMAGE_HOST_DIR%/}/${ordner_name}_${stamp}"
    mkdir -p "$BACKUP_DIR" ||
        die "Unterordner konnte nicht erstellt werden: $BACKUP_DIR"
    return 0
}


ask_target_dir() {
    local src_disk="${1:-}"
    local dir dir_disk

    while true; do
        print_prompt "Zielverzeichnis für das Image: "
        if ! read -r dir; then
            die "Vom Benutzer abgebrochen."
        fi
        case "$dir" in
            0) exit 0 ;;
            00) menu_quit ;;
            000) user_abort ;;
        esac
        if [[ -z "$dir" ]]; then
            print_warn "Kein Verzeichnis angegeben – bitte erneut eingeben (0 = zurück)."
            continue
        fi
        if [[ ! -d "$dir" ]]; then
            print_warn "Verzeichnis existiert nicht: $dir – bitte erneut eingeben (0 = zurück)."
            continue
        fi
        if [[ ! -w "$dir" ]]; then
            print_warn "Verzeichnis ist nicht beschreibbar: $dir – bitte erneut eingeben (0 = zurück)."
            continue
        fi
        if [[ -n "$src_disk" ]]; then
            dir_disk="$(target_parent_disk "$dir")"
            if [[ -n "$dir_disk" && "$dir_disk" == "$src_disk" ]]; then
                print_warn "Verzeichnis liegt auf der Quellplatte ($src_disk) – bitte ein Verzeichnis auf einer ANDEREN Platte wählen."
                continue
            fi
        fi
        ASK_DIR_RESULT="${dir%/}"
        return 0
    done
}

ask_image_file() {
    local prompt="$1"
    local path

    while true; do
        print_prompt "$prompt"
        if ! read -r path; then
            die "Vom Benutzer abgebrochen."
        fi
        case "$path" in
            0) exit 0 ;;
            00) menu_quit ;;
            000) user_abort ;;
        esac
        if [[ -z "$path" ]]; then
            print_warn "Kein Pfad angegeben – bitte erneut eingeben (0 = zurück)."
            continue
        fi
        if [[ ! -f "$path" ]]; then
            print_warn "Datei nicht gefunden: $path – bitte erneut eingeben (0 = zurück)."
